              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Verify Status 201 Created\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "const res = pm.response.json();\r",
                  "if (res && res.id) {\r",
                  "    pm.environment.set(\"userId\", res.id);\r",
