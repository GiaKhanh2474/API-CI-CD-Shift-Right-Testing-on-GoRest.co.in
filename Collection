              "script": {
                "exec": [
                  "const name = pm.iterationData.get(\"name\") || \"Pham Gia Khanh\";\r",
                  "const gender = pm.iterationData.get(\"gender\") || \"male\";\r",
                  "const status = pm.iterationData.get(\"status\") || \"active\";\r",
                  "const rawEmail = pm.iterationData.get(\"email\") || \"pgkhanh_vlu@gmail.com\";\r",
                  "\r",
                  "// Gắn thêm timestamp để chạy lại nhiều lần không bị lỗi trùng email cũ\r",
                  "const uniqueEmail = rawEmail.replace(\"@\", \"_\" + Date.now() + \"@\");\r",
                  "\r",
                  "pm.environment.set(\"req_name\", name);\r",
                  "pm.environment.set(\"req_gender\", gender);\r",
                  "pm.environment.set(\"req_status\", status);\r",
                  "pm.environment.set(\"savedEmail\", uniqueEmail);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
